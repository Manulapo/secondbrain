{
  "name": "secondbrain",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "db:tunnel": "ssh -N -T -o ExitOnForwardFailure=yes -L 5433:127.0.0.1:5432 surface",
    "dev:with-db": "concurrently --kill-others --names tunnel,next \"npm run db:tunnel\" \"wait-on tcp:5433 && next dev\"",
    "contract:emit": "prisma contract emit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
