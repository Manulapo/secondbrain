{
  "name": "secondbrain",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "db:tunnel": "ssh -N -T -o ExitOnForwardFailure=yes -L 5433:127.0.0.1:5432 surface",
    "dev:with-db": "concurrently --kill-others --names tunnel,next \"npm run db:tunnel\" \"wait-on tcp:5433 && next dev\"",
    "contract:emit": "prisma contract emit"
  },
  "dependencies": {
    "@prisma/orm-postgres": "^8.0.0-rc.11",
    "dotenv": "^17.4.2",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.4.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^8.0.0-rc.15",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  }
}
